#!/usr/bin/env bash
# Lints staged opencode-plugins sources; when vendor.manifest is staged, refreshes vendored files and stages them.
set -e

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

staged="$(git diff --cached --name-only)"

if grep -q '^apps/opencode-plugins/.*\.tsx\?$' <<< "$staged"; then
    node apps/opencode-plugins/lint.mjs
fi

grep -qx 'vendor.manifest' <<< "$staged" || exit 0

scripts/vendor.sh

while IFS= read -r line || [ -n "$line" ]; do
    [[ -z "${line// }" || "$line" =~ ^[[:space:]]*# ]] && continue
    [[ "$line" == *"|"* ]] && line="${line%%|*}"
    read -r _ _ _ dest <<< "$line"
    git add "$dest"
done < vendor.manifest
