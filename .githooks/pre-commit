#!/usr/bin/env bash
# Lints staged opencode-plugins sources; when vendor.manifest is staged, refreshes vendored files and stages them.
set -e

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

staged="$(git diff --cached --name-only)"

# Block secrets: any added line that looks like a key or token stays out of history.
if git diff --cached -U0 | grep -E '^\+' | grep -v '^+++' | grep -E -q 'sk-[A-Za-z0-9_-]{20,}|ANTHROPIC_AUTH_TOKEN"?[:= ]+"?[A-Za-z0-9_-]{16,}|-----BEGIN [A-Z ]*PRIVATE KEY-----|gh[pousr]_[A-Za-z0-9]{30,}|AKIA[0-9A-Z]{16}'; then
    echo "pre-commit: a staged line looks like a secret (key, token or private key). Move it to the Keychain and commit again." >&2
    exit 1
fi

if grep -q '^apps/opencode-plugins/.*\.tsx\?$' <<< "$staged"; then
    node apps/opencode-plugins/lint.mjs
fi

grep -qx 'vendor.manifest' <<< "$staged" || exit 0

scripts/vendor.sh

while IFS= read -r line || [ -n "$line" ]; do
    [[ -z "${line// }" || "$line" =~ ^[[:space:]]*# ]] && continue
    [[ "$line" == *"|"* ]] && line="${line%%|*}"
    read -r _ _ _ dest <<< "$line"
    git add "$dest"
done < vendor.manifest
