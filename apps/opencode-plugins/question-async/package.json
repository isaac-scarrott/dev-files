    "smoke": "node test/smoke.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@opencode/plugin": "2.2.5",
    "solid-js": "1.9.10"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-solid": "^2.11.15"
  }
}
