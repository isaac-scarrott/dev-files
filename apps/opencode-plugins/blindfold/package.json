{
  "name": "opencode-blindfold",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js",
      "default": "./dist/tui.js"
    },
    "./rpc": {
      "types": "./dist/rpc.d.ts",
      "import": "./dist/rpc.js",
      "default": "./dist/rpc.js"
    },
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit",
    "test": "bun --conditions=browser test",
    "smoke": "bun -e \"Promise.all([import('./dist/server.js'), import('./dist/tui.js')]).then((modules) => { for (const m of modules) if (!m.default?.id || typeof m.default.setup !== 'function') throw new Error('missing V2 plugin export') })\" && bun --conditions=import -e \"if (typeof require('./dist/gui-experimental.cjs').default?.setup !== 'function') throw new Error('missing GUI plugin export')\""
  },
  "license": "MIT",
  "dependencies": {
    "@opencode/plugin": "2.2.5",
    "solid-js": "1.9.10"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-solid": "^2.11.15"
  }
}
