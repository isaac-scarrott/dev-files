{
  "name": "file-viewer",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts",
    "smoke": "node --conditions=browser test/smoke.mjs"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.5",
    "solid-js": "1.9.10"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "happy-dom": "^21.0.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-solid": "^2.11.15"
  },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts"
}
