{
  "name": "native-ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "OpenCode Desktop host primitives, copied from the installed app's source so the app's own CSS styles them. Imported by sibling plugins by relative path and bundled by their vite build.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=browser --import tsx --import ./test/register.mjs --test src/*.test.tsx"
  },
  "peerDependencies": {
    "@opencode/plugin": "2.2.5",
    "solid-js": "1.9.10"
  },
  "devDependencies": {
    "@babel/core": "^8.0.10",
    "@babel/preset-typescript": "^8.0.7",
    "@opencode/plugin": "2.2.5",
    "@types/node": "^22.20.5",
    "babel-preset-solid": "^1.9.16",
    "happy-dom": "^21.0.4",
    "solid-js": "1.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
