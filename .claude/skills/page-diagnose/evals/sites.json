{
 "note": "Real public pages the evals run on, in the tours, activities and travel-booking sector. `node eval.mjs capture` freezes each to evals/snapshots/<id>/. group: good | poor | other (marketing or out-of-sector pages, reported separately and never tuned on). split: tune | held (held-out pages were not looked at while choosing checks, weights or tolerances).",
 "fidelity": [
  "headout-home",
  "tiqets-listing",
  "airbnb-detail"
 ],
 "sites": {
  "headout": {
   "group": "good",
   "split": "tune",
   "why": "Owner-named."
  },
  "airbnb": {
   "group": "good",
   "split": "tune",
   "why": "Owner-named."
  },
  "tiqets": {
   "group": "good",
   "split": "tune",
   "why": "Owner-listed candidate, and one of the three inspiration sites of the 9 Oct hand diagnosis."
  },
  "booking": {
   "group": "good",
   "split": "held",
   "why": "Owner-listed candidate (Booking.com attractions)."
  },
  "musement": {
   "group": "good",
   "split": "held",
   "why": "My pick, not the owner's: TUI's marketplace, a peer of the owner-listed candidates that blocked us. Looked at before measuring: search on the first screen, rows of photo cards each with rating and from-price, one type family."
  },
  "britishtours": {
   "group": "poor",
   "split": "tune",
   "why": "Looked at before measuring: at 1440 the page is a narrow column of small text; tour cards carry no price or rating; there is no way to search or filter tours; the product page has one photo and an enquiry form instead of a booking step; a reCAPTCHA badge overlaps the content."
  },
  "walks": {
   "group": "poor",
   "split": "tune",
   "why": "Looked at before measuring: a fixed-width layout of red and black text blocks; the listing is a plain list of links with no photos, prices or ratings; navigation is rows of text links around a calendar widget."
  },
  "tickitaly": {
   "group": "poor",
   "split": "tune",
   "why": "Looked at before measuring: listing and product pages are long paragraphs of small text rather than cards; clip-art icons and boxed blue and green navigation; no ratings anywhere."
  },
  "pragueticketoffice": {
   "group": "poor",
   "split": "tune",
   "why": "Looked at before measuring: the home page leads with a four-field search form over a banner; results are table-like rows of small text with no ratings; several text sizes and colours compete in each row."
  },
  "florencemuseum": {
   "group": "poor",
   "split": "held",
   "why": "Looked at before measuring: a fixed-width layout that does not adapt to a phone; gold buttons with tiny labels; museum blocks are paragraphs with a thumbnail; the booking form sits in the middle of the product text."
  },
  "internationalfriends": {
   "group": "poor",
   "split": "held",
   "why": "Looked at before measuring: three stacked header bands of small links and badges; the listing at 390 is headings and paragraphs with no cards or prices; the product page opens with a map and small photos. The weakest case for 'plainly poor' in the set."
  },
  "weekendinitaly": {
   "group": "poor",
   "split": "held",
   "why": "Looked at before measuring: the listing is a column of category links beside text-heavy tiles; small text throughout; the home page is a hero with a centred form and little else."
  },
  "gotobus": {
   "group": "poor",
   "split": "held",
   "why": "Looked at before measuring: the home page under the search form is three columns of small blue text links with prices: a link directory, no photos, no cards. Home page only."
  },
  "viennaticketoffice": {
   "group": "poor",
   "split": "held",
   "why": "Looked at before measuring: red, black and white panels of different sizes compete on the first screen; numbered thumbnails with tiny captions; a floating chat widget and voucher box overlap content. Home page only."
  }
 },
