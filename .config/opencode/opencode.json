{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "plan": {
      "mode": "primary",
      "model": "openai/gpt-5.5"
    },
    "build": {
      "mode": "primary",
      "model": "openai/gpt-5.5"
    },
    "explore": {
      "model": "github-copilot/claude-haiku-4.5"
    }
  },
  "default_agent": "plan",
  "mcp": {
    "paper": {
      "type": "remote",
      "url": "http://127.0.0.1:29979/mcp",
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "pnpm",
        "dlx",
        "chrome-devtools-mcp@latest"
      ],
      "environment": {},
      "enabled": true
    }
  }
}
